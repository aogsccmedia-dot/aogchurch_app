{
  "name": "aogchurch-app",
  "version": "1.0.0",
  "private": true,
  "description": "AOG Sandton City Church Youth — aogsccyouth.com. Cloudflare Workers + Static Assets + D1 + KV/R2.",
  "type": "module",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "dev": "wrangler dev",
    "preview:node": "node --experimental-strip-types --experimental-sqlite --no-warnings test/support/server.ts",
    "test": "node --experimental-strip-types --experimental-sqlite --no-warnings --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply aogscc-youth-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply aogscc-youth-db --local",
    "db:new": "wrangler d1 migrations create aogscc-youth-db",
    "logs": "wrangler tail"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "typescript": "^5.6.3",
    "wrangler": "^4.149.0"
  }
}
